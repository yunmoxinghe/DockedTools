<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap5 rescap com desktop">

  <Identity
    Name="8B8CC4F4.482486777ECD9.Debug"
    Publisher="CN=A19C62A9-1AA6-44AB-9F57-2DE6C380D9C9"
    Version="1.1.148.0" />

  <mp:PhoneIdentity PhoneProductId="3bb471d1-b8f7-4b6d-bba5-cc1b59b654ad" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>边栏助手 (Debug)</DisplayName>
    <PublisherDisplayName>云漠星</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-Hans"/>
    <Resource Language="en-US"/>
  </Resources>


  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="边栏助手 (Debug)"
        Description="DockedTools"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"  Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png" ShortName="边栏助手 (Debug)">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square310x310Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square150x150Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget>
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>Text</uap:DataFormat>
            <uap:DataFormat>WebLink</uap:DataFormat>
            <uap:DataFormat>Uri</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
        <!-- 开机自启动：本包是 packaged desktop app（runFullTrust + Windows.FullTrustApplication），
             必须用 desktop: 命名空间；uap5: 是 UWP/AppContainer 的语法，用在桌面包上
             Enabled 属性会被忽略、只能靠 RequestEnableAsync + 用户同意对话框。
             ⚠️ Executable 写死 DockedTools.exe，不能抄 Application 的 $targetnametoken$.exe
             —— 构建只替换 Application/@Executable（同下面 com:ExeServer 那个坑）。 -->
        <desktop:Extension Category="windows.startupTask"
          Executable="DockedTools.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="AppStartupTask"
            Enabled="true"
            DisplayName="边栏助手 (Debug)" />
        </desktop:Extension>

        <!-- 网页通知：把本应用登记成系统通知的激活目标。
             两条是一套，缺一则应用没在跑时点通知唤不起来（只会被当成普通启动，拿不到 arguments）：
             desktop 那条声明「点击通知时激活这个 CLSID」；
             com 那条把该 CLSID 真的注册成一个 COM 服务器，并指回本 exe。
             ⚠️ Arguments 必须是【四个】短横 —— WindowsAppSDK 靠这个前缀
             把命令行负载识别成 AppNotification，写成两个会静默退化成普通启动。
             ⚠️ Executable 这里写死 DockedTools.exe，不能抄上面 Application 的
             $targetnametoken$.exe —— 构建只替换 Application/@Executable 这一处，
             写在这里会原样带进最终的 AppxManifest.xml，COM 激活时找不到文件。
             （worktree 隔离改的是包身份不是 exe 名，写死不受影响。） -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="7413497E-3991-4463-BB6A-39AD3B1E3357" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="DockedTools.exe" DisplayName="边栏助手 (Debug)" Arguments="----AppNotificationActivated:">
              <com:Class Id="7413497E-3991-4463-BB6A-39AD3B1E3357" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
