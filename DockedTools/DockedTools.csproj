<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DockedTools</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 根据构建配置切换 Package Manifest -->
  <ItemGroup>
    <!-- 排除默认的 Package.appxmanifest -->
    <None Remove="Package.appxmanifest" />
    <AppxManifest Remove="Package.appxmanifest" />
    
    <!-- 条件化包含对应配置的 manifest -->
    <!-- 本地临时覆盖清单（不提交）：存在时 Debug 构建优先用它，用于多 worktree 并存安装 -->
    <AppxManifest Include="Package.Local.appxmanifest" Condition="'$(Configuration)'=='Debug' and Exists('$(MSBuildProjectDirectory)\Package.Local.appxmanifest')">
      <SubType>Designer</SubType>
    </AppxManifest>
    <AppxManifest Include="Package.Debug.appxmanifest" Condition="'$(Configuration)'=='Debug' and !Exists('$(MSBuildProjectDirectory)\Package.Local.appxmanifest')">
      <SubType>Designer</SubType>
    </AppxManifest>
    <AppxManifest Include="Package.Release.appxmanifest" Condition="'$(Configuration)'=='Release'">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!-- XAML 应用定义 -->
  <ItemGroup>
    <Page Remove="功能\应用入口\App.xaml" />
    <ApplicationDefinition Include="功能\应用入口\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- 图标数据文件 -->
  <ItemGroup>
    <Content Include="功能\页面\设置\网页组设置\图标数据.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.16" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />

    <!--
      浏览器扩展桥接服务需要 Kestrel + WebSocket 中间件（.NET 的 HttpListener 没有 AcceptWebSocketAsync）。
      ⚠️ 这会引入 ASP.NET Core 运行时，Native AOT 发布体积会显著变大。
      若 AOT 发布阶段出问题，备选是换成手写 TcpListener + RFC6455 实现，BridgeSession.HandleAsync 接口不用动。
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
  <PublishTrimmed>true</PublishTrimmed>
  <PublishReadyToRun>false</PublishReadyToRun>
  <InvariantGlobalization>false</InvariantGlobalization>
  <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
  <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
  <PackageCertificateKeyFile>Docked AI_StoreKey.pfx</PackageCertificateKeyFile>
  <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
  <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
  <GenerateTestArtifacts>False</GenerateTestArtifacts>
  <AppxBundle>Always</AppxBundle>
  <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
  
  <!-- 🌍 本地化配置：将所有语言资源打包到主包中，支持应用内语言切换 -->
  <!-- 只自动分割 Scale 和 DXFeatureLevel 资源，语言资源不分割 -->
  <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
  <!-- 声明应用支持的所有语言 -->
  <AppxDefaultResourceQualifiers>Language=zh-Hans;en-US</AppxDefaultResourceQualifiers>
  
  <!-- 🔍 调试符号配置：生成 PDB 文件用于崩溃分析 -->
  <!-- 即使是 Release 模式也生成符号文件，用于 Partner Center 崩溃分析 -->
  <DebugType>embedded</DebugType>
  <DebugSymbols>true</DebugSymbols>
  <!-- 包含符号包到 .msixupload 文件中 -->
  <GenerateAppxSymbolPackage>true</GenerateAppxSymbolPackage>
  <!-- 上传到商店时包含符号文件 -->
  <AppxSymbolPackageEnabled>true</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <!-- ==========================================================================
       worktree 包身份隔离

       问题：每个 git worktree 都是一份完整源码，但 Package.Debug.appxmanifest 里的
       Identity Name 是写死的。于是多个 worktree 的 Debug 构建共用同一个包身份，
       后部署的会顶掉先部署的 —— 装不共存，更别提同时运行。

       做法：从仓库目录名（如 main-ffb0958c）里取 hash 段的前 4 位，生成 .WTFFB0
       这样的后缀，同时改两处：
         1. MSIX Identity Name（决定能不能并存安装）
         2. 运行时单实例标识（决定能不能同时运行）——见 功能/应用入口/WorktreeIdentity.g.cs

       只动 Name、不动 Publisher：Publisher 必须与签名证书 Subject（CN=A19C62A9-...）
       完全一致，改了就得换证书。Name 只影响 PackageFamilyName，装几个互不干扰。

       约定与已有包一致：main-3ea53c21 → WT3EA5（机器上已装的那个就是这么来的）。
       Release 与目录名不含 hash 时后缀为空，行为与改动前完全相同。
       ========================================================================== -->
  <PropertyGroup>
    <_RepoDirName>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))</_RepoDirName>
    <_WtHash>$([System.Text.RegularExpressions.Regex]::Match('$(_RepoDirName)', '-([0-9a-fA-F]{4,})').Groups[1].Value)</_WtHash>
    <_WtHash4 Condition="'$(_WtHash)' != ''">$(_WtHash.Substring(0, 4))</_WtHash4>
    <!-- 优先级：命令行 -p:WorktreeSuffix=.WTABCD  >  环境变量 WORKTREE_SUFFIX  >  目录名派生。
         前两者是给「目录名不含 hash」的 worktree 留的兜底（脚本工具\worktree.ps1 会用到）。 -->
    <WorktreeSuffix Condition="'$(WorktreeSuffix)' == '' AND '$(env:WORKTREE_SUFFIX)' != ''">$(env:WORKTREE_SUFFIX)</WorktreeSuffix>
    <WorktreeSuffix Condition="'$(WorktreeSuffix)' == '' AND '$(Configuration)' == 'Debug' AND '$(_WtHash4)' != ''">.WT$(_WtHash4.ToUpperInvariant())</WorktreeSuffix>
    <WorktreeSuffix Condition="'$(WorktreeSuffix)' == ''"></WorktreeSuffix>
    <_WtIdentityFile>$(MSBuildProjectDirectory)\功能\应用入口\WorktreeIdentity.g.cs</_WtIdentityFile>
  </PropertyGroup>

  <!-- 该文件已加入 .gitignore，clone 后本地并不存在。默认 Compile glob 只在评估阶段枚举
       一次磁盘，届时文件还没被 _WriteWorktreeIdentity 写出，就会被漏掉、导致 CS0246。
       这里先按字面路径把它从默认 glob 里摘掉（文件不存在时 Remove 是空操作，无害），
       再无条件显式 Include：显式项不校验文件是否存在，等 BeforeBuild 写出后照常参与编译。 -->
  <ItemGroup>
    <Compile Remove="功能\应用入口\WorktreeIdentity.g.cs" />
    <Compile Include="功能\应用入口\WorktreeIdentity.g.cs" />
  </ItemGroup>

  <!-- 始终写出身份文件：Debug 带后缀，其余写空串，保证 Release 行为不变 -->
  <Target Name="_WriteWorktreeIdentity" BeforeTargets="BeforeBuild">
    <WriteLinesToFile
      File="$(_WtIdentityFile)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Lines="// &lt;auto-generated/&gt;;internal static class WorktreeIdentity;{;    public const string Suffix = &quot;$(WorktreeSuffix)&quot;%3B;}" />
    <Message Importance="high"
             Text="worktree 身份后缀 = [$(WorktreeSuffix)]  （目录 $(_RepoDirName)，配置 $(Configuration)）"
             Condition="'$(WorktreeSuffix)' != ''" />
  </Target>

  <!-- Debug 且拿到后缀时，生成一份带新身份的 manifest 顶替 Package.Debug.appxmanifest -->
  <Target Name="_WorktreeDebugManifest" BeforeTargets="BeforeBuild"
          Condition="'$(Configuration)' == 'Debug' AND '$(WorktreeSuffix)' != ''">
    <PropertyGroup>
      <_WtManifest>$(IntermediateOutputPath)Package.Debug.worktree.appxmanifest</_WtManifest>
      <_WtNs>&lt;Namespace Prefix='p' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10'/&gt;&lt;Namespace Prefix='uap5' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10/5'/&gt;</_WtNs>
      <_WtPkgName>8B8CC4F4.482486777ECD9.Debug$(WorktreeSuffix)</_WtPkgName>
      <_WtDisplay>边栏助手 (Debug$(WorktreeSuffix))</_WtDisplay>
    </PropertyGroup>

    <Copy SourceFiles="Package.Debug.appxmanifest" DestinationFiles="$(_WtManifest)" />

    <XmlPoke XmlInputPath="$(_WtManifest)" Namespaces="$(_WtNs)"
             Query="/p:Package/p:Identity/@Name" Value="$(_WtPkgName)" />
    <XmlPoke XmlInputPath="$(_WtManifest)" Namespaces="$(_WtNs)"
             Query="/p:Package/p:Properties/p:DisplayName" Value="$(_WtDisplay)" />
    <XmlPoke XmlInputPath="$(_WtManifest)" Namespaces="$(_WtNs)"
             Query="/p:Package/p:Applications/p:Application/uap:VisualElements/@DisplayName" Value="$(_WtDisplay)" />
    <XmlPoke XmlInputPath="$(_WtManifest)" Namespaces="$(_WtNs)"
             Query="/p:Package/p:Applications/p:Application/uap:VisualElements/uap:DefaultTile/@ShortName" Value="$(_WtDisplay)" />
    <XmlPoke XmlInputPath="$(_WtManifest)" Namespaces="$(_WtNs)"
             Query="/p:Package/p:Applications/p:Application/p:Extensions/uap5:Extension/uap5:StartupTask/@DisplayName" Value="$(_WtDisplay)" />

    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_WtManifest)">
        <SubType>Designer</SubType>
      </AppxManifest>
    </ItemGroup>

    <Message Importance="high" Text="Debug 包身份已隔离为 $(_WtPkgName)" />
  </Target>
</Project>