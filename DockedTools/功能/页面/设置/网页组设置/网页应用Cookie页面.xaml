<Page
    x:Class="DockedTools.Features.Pages.Settings.WebSettings.WebAppCookiePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    xmlns:cookies="using:DockedTools.Features.Pages.WebApp.Browser.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseLayoutRounding="True">

    <Grid
        x:Name="RootGrid"
        Padding="0"
        UseLayoutRounding="True">

        <!-- 读 Cookie 用的临时内核宿主。
             Cookie 只能挂在活着的 CoreWebView2 上，一个网页应用都没开时就没有内核可借，
             于是这里按需拉一个「空」内核专门读 Cookie（对应用户点「创建临时内核」）。
             ⚠️ 必须 Visible 且非零尺寸：Collapsed / 0×0 的 WebView2 不会完成
             EnsureCoreWebView2Async。所以给 1×1 并用 Opacity 藏起来，
             靠左上角对齐塞住，不参与布局也不占可见空间。 -->
        <winui:WebView2
            x:Name="CookieTempWebView"
            Width="1"
            Height="1"
            Opacity="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            DefaultBackgroundColor="Transparent"/>

        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageContentPanel"
                Margin="16,0"
                UseLayoutRounding="True"
                Spacing="0">

                <Border Height="40" />
                <TextBlock
                    x:Name="PageTitleBlock"
                    x:Uid="WebAppCookiePage_Title"
                    FontSize="32"
                    FontWeight="SemiBold" />
                <Border Height="16" />

                <!-- 提示 / 错误统一走 InfoBar：自带图标、语义配色，长文案自动换行，
                     比自己糊一个 TextBlock 稳。加载中在这里显示「正在读取」。 -->
                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    Severity="Informational"
                    IsClosable="False"
                    Margin="0,0,0,16"/>

                <Border Height="20" />

                <StackPanel Spacing="4">

                    <!-- 操作区 -->
                    <controls:SettingsCard
                        x:Uid="WebAppCookiePage_Actions"
                        HorizontalContentAlignment="Stretch">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </controls:SettingsCard.HeaderIcon>

                        <!-- 用等宽 Grid 而不是横向 StackPanel：StackPanel 按内容宽度排，
                             卡片一窄按钮就会溢出被裁掉；Width="*" 的三列会跟着卡片
                             一起收放，任何宽度下都装得下，按钮拉伸填满各自那列。 -->
                        <Grid RowSpacing="8" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                x:Uid="WebAppDetailPage_CookieRefresh"
                                Click="OnRefreshCookieClicked"/>
                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                x:Uid="WebAppDetailPage_CookieClearSite"
                                Click="OnClearSiteCookieClicked"/>
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                x:Uid="WebAppDetailPage_CookieClearAll"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnClearAllCookieClicked"/>

                            <!-- 借不到内核时的手动兜底：拉一个临时内核专门读 Cookie。
                                 单独占一整行 —— 它文案长，且是「环境准备」性质，
                                 跟上面三个常规操作不是一类动作。 -->
                            <Button
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                HorizontalAlignment="Stretch"
                                x:Uid="WebAppDetailPage_CookieCreateTempCore"
                                Click="OnCreateTempCoreClicked"/>

                            <ProgressRing
                                x:Name="CookieLoadingRing"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                IsActive="False"/>
                        </Grid>
                    </controls:SettingsCard>

                </StackPanel>

                <Border Height="16" />
                <TextBlock
                    x:Uid="WebAppCookiePage_ListSection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="1,16,0,4"/>

                <!-- Cookie 列表：一条 Cookie 一张 SettingsCard，直接摊在外层 ScrollViewer 里。

                     ⚠️ 为什么是 ItemsControl 而不是 ListView：ListView 内部自带
                     ScrollViewer，套在页面自己的 ScrollViewer 里就成了「滚动区里套滚动区」
                     —— 滚轮手势先被内层吃满才交给外层，列表还得靠 MaxHeight 截一段，
                     滚到底的体感很割裂。ItemsControl 不带滚动条，卡片直接把页面撑开，
                     整页只有一条滚动条，跟设置页 / 详情页那几列 SettingsCard 完全一致。

                     ⚠️ 为什么不能用 ItemsRepeater：本项目 PublishAot + CsWinRT，
                     ItemsRepeater.ItemsSource 只认 WinRT 容器。Cookie 项是纯 CLR 类型，
                     不存在 IVector<WebAppCookieItem> 这个泛型实例化，实测直接抛
                     "Argument 'source' is not a supported vector."。
                     ItemsControl 走 IEnumerable 包装路径，能吃 CLR 集合。

                     代价：ItemsControl 没有虚拟化，Cookie 多时会一次性建出全部卡片。
                     单个站点的 Cookie 通常在几十条量级，这个代价可以接受。 -->
                <ItemsControl
                    x:Name="CookieItemsControl"
                    HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="cookies:WebAppCookieItem">
                            <!-- HorizontalAlignment="Stretch" 不能省：ItemsControl 没有
                                 ListViewItem 那样的容器帮忙拉伸，卡片不写就是按内容宽度
                                 缩在左边，跟上面的操作卡对不齐。 -->
                            <controls:SettingsCard
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch">
                                <!-- Header / Description 都是 ContentPresenter，
                                     控件模板里自带 TextWrapping="Wrap"。长 Name、
                                     长 Domain 会跟着卡片宽度自动换行 —— 自己拿
                                     TextBlock 排会因为测量宽度无限而单行溢出被裁。 -->
                                <controls:SettingsCard.Header>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"/>
                                </controls:SettingsCard.Header>

                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="2">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Domain}" />
                                            <Run Text="{Binding Path}" />
                                        </TextBlock>
                                        <TextBlock
                                            Text="{Binding ExpiresText}"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>
                                </controls:SettingsCard.Description>

                                <!-- 单条删除：Tag 绑到数据项本身，
                                     点击处理里按它取 name/domain/path 精确删除 -->
                                <Button
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    Tag="{Binding}"
                                    Click="OnDeleteCookieClicked">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
