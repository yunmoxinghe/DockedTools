<Page
    x:Class="DockedTools.Features.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:customControls="using:DockedTools.Features.UnifiedCalls.CustomControls"
    mc:Ignorable="d"
    UseLayoutRounding="True">

    <Grid
        x:Name="RootGrid"
        Padding="0"
        UseLayoutRounding="True">
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageContentPanel"
                Margin="16,0"
                UseLayoutRounding="True"
                Spacing="0">
                <Border Height="40" />
                <TextBlock
                    x:Name="PageTitleBlock"
                    x:Uid="SettingsPage_Title"
                    FontSize="32"
                    FontWeight="SemiBold" />
                <Border Height="36" />

                <StackPanel
                    x:Name="CardsPanel"
                    Spacing="4">
                    <!-- 当状态为 DisabledByUser 时显示提示信息 -->
                    <InfoBar
                        x:Uid="SettingsPage_UserDisabledInfo"
                        Severity="Informational"
                        IsOpen="{x:Bind ViewModel.ShowUserDisabledInfo, Mode=OneWay, FallbackValue=False}"
                        IsClosable="False"
                        Visibility="{x:Bind ViewModel.ShowUserDisabledInfo, Mode=OneWay, FallbackValue=Collapsed}"/>

                    <!-- 当状态为 DisabledByPolicy 时显示警告 -->
                    <InfoBar
                        x:Uid="SettingsPage_PolicyWarning"
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.ShowPolicyWarning, Mode=OneWay, FallbackValue=False}"
                        IsClosable="False"
                        Visibility="{x:Bind ViewModel.ShowPolicyWarning, Mode=OneWay, FallbackValue=Collapsed}"/>

                    <!-- 常规设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_GeneralSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <!-- 开机自启动设置 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_StartupHeader"
                        IsClickEnabled="True"
                        Click="OnSettingCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7B5;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </controls:SettingsCard.ActionIcon>
                        <ToggleSwitch 
                            IsOn="{x:Bind ViewModel.IsStartupEnabled, Mode=OneWay, FallbackValue=False}"
                            IsEnabled="{x:Bind ViewModel.CanToggle, Mode=OneWay, FallbackValue=False}"
                            Toggled="OnToggleSwitched"/>
                    </controls:SettingsCard>

                    <!-- 窗口停靠位置设置 -->
                    <controls:SettingsExpander
                        x:Name="DockSideExpander"
                        x:Uid="SettingsPage_DockSideHeader"
                        IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE746;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <ComboBox
                            x:Name="DockSideComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnDockSideChanged">
                            <ComboBoxItem x:Uid="SettingsPage_DockSideLeft" Tag="0" Content="左侧"/>
                            <ComboBoxItem x:Uid="SettingsPage_DockSideRight" Tag="1" Content="右侧"/>
                        </ComboBox>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPage_LeftDockNavigationHeader">
                                <ToggleSwitch
                                    x:Name="LeftDockNavigationToggle"
                                    Toggled="OnLeftDockNavigationToggled"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsCard
                        x:Uid="SettingsPage_LanguageHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnLanguageCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="LanguageComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem x:Uid="SettingsPage_LanguageSystem" Tag="" Content="跟随系统"/>
                            <ComboBoxItem x:Uid="Language_SimplifiedChinese" Tag="zh-CN" Content="简体中文"/>
                            <ComboBoxItem x:Uid="Language_English" Tag="en-US" Content="English"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 交互设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_InteractionSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>

                    <!-- 内容区背景材质 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_ContentAreaBackdropHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnContentAreaBackdropCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE771;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ContentAreaBackdropComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnContentAreaBackdropChanged">
                            <ComboBoxItem x:Uid="SettingsPage_BackdropSolidColor" Tag="0" Content="纯色背景"/>
                            <ComboBoxItem x:Uid="SettingsPage_BackdropMicaBase" Tag="1" Content="云母材质"/>
                            <ComboBoxItem x:Uid="SettingsPage_BackdropMicaAlt" Tag="2" Content="云母 Alt"/>
                            <ComboBoxItem x:Uid="SettingsPage_BackdropAcrylic" Tag="3" Content="亚克力"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 托盘关闭窗口行为 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_TrayCloseWindowBehaviorHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnTrayCloseWindowBehaviorCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEA99;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="TrayCloseWindowBehaviorComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnTrayCloseWindowBehaviorChanged">
                            <ComboBoxItem x:Uid="SettingsPage_TrayCloseDestroyWindow" Tag="0" Content="直接销毁窗口"/>
                            <ComboBoxItem x:Uid="SettingsPage_TrayCloseRestartToTray" Tag="1" Content="重启到仅托盘"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 侧边栏返回按钮 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_BackButtonHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnBackButtonCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="BackButtonToggle"
                            Toggled="OnBackButtonToggled"/>
                    </controls:SettingsCard>

                    <!-- Frame 导航动画设置 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_FrameAnimationHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnFrameAnimationCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox 
                            x:Name="FrameAnimationComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnFrameAnimationChanged">
                            <ComboBoxItem x:Uid="SettingsPage_AnimationNone" Tag="0"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationEntrance" Tag="1"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideRight" Tag="2"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideLeft" Tag="3"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideBottom" Tag="4"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationDrillIn" Tag="5"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationFadeInOut" Tag="6"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationScale" Tag="7"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 子页面导航动画设置 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_SubPageAnimationHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnSubPageAnimationCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE724;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox 
                            x:Name="SubPageAnimationComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnSubPageAnimationChanged">
                            <ComboBoxItem x:Uid="SettingsPage_AnimationNone" Tag="0"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationEntrance" Tag="1"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideRight" Tag="2"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideLeft" Tag="3"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideBottom" Tag="4"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationDrillIn" Tag="5"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationFadeInOut" Tag="6"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationScale" Tag="7"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 全局快捷键设置 -->
                    <controls:SettingsExpander x:Name="HotkeyExpander"
                                          x:Uid="SettingsPage_HotkeyHeader"
                                          IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE765;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <ToggleSwitch 
                            x:Name="HotkeyToggle"
                            Toggled="OnHotkeyToggled"/>
                        
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPage_HotkeyConfigHeader"
                                              IsClickEnabled="True"
                                              Click="OnHotkeyButtonClick">
                                <ItemsControl x:Name="HotkeyKeysDisplay" 
                                            HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <customControls:KeyVisual Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:SettingsCard>
                            
                            <controls:SettingsCard x:Uid="SettingsPage_TouchpadSettingsHeader"
                                              IsClickEnabled="True"
                                              Click="OnTouchpadSettingsClick">
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;"/>
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- 网页设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_WebSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <!-- 网页应用管理 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_WebAppManagementHeader"
                        Header="网页应用管理"
                        Description="管理已添加的网页应用，包括名称、网址、图标以及 Cookie 等信息。"
                        IsClickEnabled="True"
                        Click="OnWebAppManagementCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F1;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE76C;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>
                    
                    <!-- 链接打开方式 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_LinkOpenBehaviorHeader"
                        Header="链接打开方式"
                        Description="设置点击 target=&quot;_blank&quot; 等新窗口链接时的行为"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnLinkOpenBehaviorCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="LinkOpenBehaviorComboBox"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnLinkOpenBehaviorChanged">
                            <ComboBoxItem x:Uid="SettingsPage_LinkOpenBehaviorAsk" Tag="0" Content="每次询问"/>
                            <ComboBoxItem x:Uid="SettingsPage_LinkOpenBehaviorSystemBrowser" Tag="1" Content="默认浏览器"/>
                            <ComboBoxItem x:Uid="SettingsPage_LinkOpenBehaviorWebViewWindow" Tag="2" Content="WebView 窗口"/>
                        </ComboBox>
                    </controls:SettingsCard>
                    
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_MaxWebViewHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnMaxWebViewCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </controls:SettingsCard.HeaderIcon>
                        <NumberBox 
                            x:Name="MaxWebViewCountBox"
                            Minimum="1"
                            Maximum="20"
                            SpinButtonPlacementMode="Inline"
                            SmallChange="1"
                            LargeChange="5"
                            HorizontalAlignment="Left"
                            ValueChanged="OnMaxWebViewCountChanged"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard 
                        x:Uid="LabPage_HideWebCloseButtonHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnHideWebViewCloseButtonCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE711;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="HideWebViewCloseButtonToggle"
                            Toggled="OnHideWebViewCloseButtonToggled"/>
                    </controls:SettingsCard>

                    <!-- WebView2 性能优化 -->
                    <controls:SettingsCard
                        x:Uid="LabPage_WebView2PerformanceHeader"
                        IsClickEnabled="True"
                        Click="OnWebViewPerformanceCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE76C;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 自适应栏色 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_AdaptiveColourHeader"
                        IsClickEnabled="True"
                        Click="OnAdaptiveColourCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE76C;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 高级设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_AdvancedSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>

                    <!-- 实验室入口 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_LabHeader"
                        IsClickEnabled="True"
                        Click="OnLabCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF196;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE76C;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 赞助 -->
                    <TextBlock 
                        x:Uid="SettingsPage_SponsorSection"
                        Text="赞助"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <!-- 支付宝赞助 -->
                    <controls:SettingsExpander 
                        x:Uid="SettingsPage_SponsorCard"
                        Header="支付宝赞助"
                        Description="通过支付宝赞赏支持开发者"
                        IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <ImageIcon Width="20" Height="20">
                                <ImageIcon.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/Alipay.svg"/>
                                </ImageIcon.Source>
                            </ImageIcon>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <StackPanel HorizontalAlignment="Center" Padding="0,8,0,8">
                                    <Image Source="ms-appx:///Assets/赞助/支付宝.jpg" 
                                           Width="200" 
                                           Height="200" 
                                           Stretch="Uniform"
                                           Margin="0,0,0,8"/>
                                    <TextBlock x:Uid="SettingsPage_AlipayScanHint"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- 微信赞助 -->
                    <controls:SettingsExpander 
                        x:Uid="SettingsPage_WeChatSponsorCard"
                        Header="微信赞助"
                        Description="通过微信赞赏支持开发者"
                        IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <ImageIcon Width="20" Height="20">
                                <ImageIcon.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/WeChat.svg"/>
                                </ImageIcon.Source>
                            </ImageIcon>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <StackPanel HorizontalAlignment="Center" Padding="0,8,0,8">
                                    <Image Source="ms-appx:///Assets/赞助/微信.png" 
                                           Width="200" 
                                           Height="200" 
                                           Stretch="Uniform"
                                           Margin="0,0,0,8"/>
                                    <TextBlock x:Uid="SettingsPage_WeChatScanHint"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- Adsterra 智能广告 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_AdsterraCard"
                        IsClickEnabled="True"
                        Click="OnAdsterraClick">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Width="20" Height="20">
                                <ImageIcon.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/adsterra.svg"/>
                                </ImageIcon.Source>
                            </ImageIcon>
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- Monetag 智能广告 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_MonetagCard"
                        IsClickEnabled="True"
                        Click="OnMonetagClick">
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Width="20" Height="20">
                                <ImageIcon.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/logos/monetag.svg"/>
                                </ImageIcon.Source>
                            </ImageIcon>
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 评价应用 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_RateAppCard"
                        Header="评价应用"
                        Description="喜欢这个应用吗？给我们评分和评论吧！"
                        IsClickEnabled="True"
                        Click="OnRateAppClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE90A;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>


                    <!-- 关于 -->
                    <TextBlock 
                        x:Uid="SettingsPage_AboutSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <controls:SettingsExpander x:Name="AboutAppExpander"
                                          x:Uid="SettingsPage_AboutHeader"
                                          IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Sparkles.ico" ShowAsMonochrome="False"/>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <TextBlock x:Name="VersionText" 
                               x:Uid="SettingsPage_Version"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPage_LinksHeader"
                                              HorizontalContentAlignment="Left"
                                              ContentAlignment="Left">
                                <StackPanel Margin="-12,0,0,0" Orientation="Vertical" Spacing="4">
                                    <HyperlinkButton Click="OnQuickFeedbackClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xED15;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind GetQuickFeedbackLinkText()}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <HyperlinkButton Click="OnOpenGitHubClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
                                            <TextBlock Text="{x:Bind GetGitHubLinkText()}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <HyperlinkButton Click="OnSendFeedbackClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xED15;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind GetFeedbackLinkText()}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
