<Page
    x:Class="DockedTools.Features.Pages.Lab.LabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseLayoutRounding="True">

    <Grid x:Name="RootGrid" Padding="0" UseLayoutRounding="True">
        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageContentPanel"
                Margin="0"
                UseLayoutRounding="True"
                Spacing="0">

                <Border Height="40" />

                <TextBlock
                    x:Name="PageTitleBlock"
                    x:Uid="LabPage_Title"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <Border Height="8" />

                <TextBlock
                    x:Uid="LabPage_Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,0"/>

                <Border Height="24" />

                <!-- 实验室分组 -->
                <TextBlock
                    x:Uid="LabPage_ExperimentalSection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="1,0,0,4"/>

                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <!-- AI 实验室 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_AILabHeader"
                        Header="AI 实验室"
                        Description="启用或禁用 AI 实验室功能"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnAILabCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF4A5;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="AILabToggle"
                            Toggled="OnAILabToggled"/>
                    </controls:SettingsCard>

                    <!-- 窗口最大化监听器状态 -->
                    <controls:SettingsCard 
                        x:Uid="LabPage_WindowMaxMonitorHeader"
                        IsClickEnabled="False"
                        IsActionIconVisible="False">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C4;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon 
                                x:Name="MaximizedStateIcon"
                                Glyph="&#xE73F;"
                                FontSize="16"/>
                            <TextBlock 
                                x:Name="MaximizedStateText"
                                x:Uid="LabPage_WindowMaxMonitorDetecting"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- WinUI 右键菜单 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_WinUIContextMenuHeader"
                        Header="WinUI 右键菜单"
                        Description="使用现代 WinUI 风格的上下文菜单"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnWinUIContextMenuCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C1;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="WinUIContextMenuToggle"
                            Toggled="OnWinUIContextMenuToggled"/>
                    </controls:SettingsCard>

                    <!-- WebView 配置备份 -->
                    <controls:SettingsCard 
                        x:Uid="LabPage_WebViewBackupHeader">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button 
                                x:Uid="LabPage_BackupButton"
                                Content="💾"
                                Click="OnQuickBackupClick"
                                ToolTipService.ToolTip="保存当前所有 WebView2 数据到桌面"
                                Style="{StaticResource AccentButtonStyle}"/>
                            <Button 
                                x:Uid="LabPage_RestoreButton"
                                Content="♻️"
                                Click="OnQuickRestoreClick"
                                ToolTipService.ToolTip="从备份文件恢复配置（需重启）"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Toast 通知测试 -->
                    <controls:SettingsCard
                        Header="Toast 通知测试"
                        Description="发送系统通知，验证 AppNotification 通道是否可用">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="发送通知"
                                    Click="OnSendToastClick"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"/>
                                <Button
                                    Content="连发 3 条"
                                    Click="OnSendToastBurstClick"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                x:Name="ToastStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </controls:SettingsCard>

                </StackPanel>

                <Border Height="12" />

                <!-- 顶部应用栏测试分组 -->
                <TextBlock
                    x:Uid="LabPage_TopAppBarSection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="1,0,0,4"/>

                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <!-- 显示/隐藏顶部应用栏 -->
                    <controls:SettingsCard x:Uid="LabPage_TopBarVisibilityHeader">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C1;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TopBarVisibilityToggle" />
                    </controls:SettingsCard>

                    <!-- 顶栏菜单按钮 -->
                    <controls:SettingsCard x:Uid="LabPage_TopBarMenuButtonHeader">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE700;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="TopBarMenuButtonToggle"
                            Toggled="OnTopBarMenuButtonToggled"/>
                    </controls:SettingsCard>

                    <!-- 设置中间标题 -->
                    <controls:SettingsCard x:Uid="LabPage_TopBarCenterHeader">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox
                                x:Name="CenterTitleInput"
                                x:Uid="LabPage_CenterTitlePlaceholder"
                                PlaceholderText="输入标题文本"
                                Width="140"
                                VerticalAlignment="Center"/>
                            <Button
                                x:Uid="LabPage_TopBarCenterSetButton"
                                Click="OnSetCenterTitleClick"
                                VerticalAlignment="Center"/>
                            <Button
                                x:Uid="LabPage_TopBarCenterClearButton"
                                Click="OnClearCenterClick"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- 设置右侧按钮 -->
                    <controls:SettingsCard x:Uid="LabPage_TopBarRightHeader">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE700;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="LabPage_TopBarRightSetButton"
                                    Click="OnSetRightButtonClick"
                                    VerticalAlignment="Center"/>
                                <Button
                                    x:Uid="LabPage_TopBarRightClearButton"
                                    Click="OnClearRightButtonClick"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                x:Name="RightButtonStatus"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- 局部主题切换测试 -->
                    <controls:SettingsCard
                        Header="局部主题切换"
                        Description="切换顶部应用栏的 Light/Dark 主题（不影响其他区域）">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="切换主题"
                                    Click="OnToggleTopBarThemeClick"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"/>
                                <Button
                                    Content="重置"
                                    Click="OnResetTopBarThemeClick"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                x:Name="ThemeStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- 顶栏输入框：实时文本 + 确认图标形态 -->
                    <controls:SettingsCard
                        Header="顶栏输入框测试"
                        Description="把居中位开成搜索框：打开开关后页面能实时收到每一次输入，右侧确认图标可以换样子">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE721;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox
                                    x:Name="AcceptGlyphInput"
                                    PlaceholderText="静态字形，如 Accept"
                                    Width="150"
                                    VerticalAlignment="Center"/>
                                <Button
                                    Content="应用"
                                    Click="OnApplySearchBoxClick"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"/>
                                <Button
                                    Content="关掉"
                                    Click="OnCloseSearchBoxClick"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox
                                x:Name="AcceptIconCombo"
                                SelectionChanged="OnAcceptIconChanged"
                                Width="220"
                                VerticalAlignment="Center"/>
                            <ToggleSwitch
                                x:Name="LiveTextToggle"
                                Header="实时接收输入内容"
                                Toggled="OnLiveTextToggled"/>
                            <TextBlock
                                x:Name="SearchBoxStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </controls:SettingsCard>

                </StackPanel>

                <Border Height="12" />

                <!-- 托盘菜单设置分组 -->
                <TextBlock
                    x:Uid="LabPage_TrayMenuSection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="1,0,0,4"/>

                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <!-- 隐藏托盘评价按钮 -->
                    <controls:SettingsCard 
                        x:Uid="LabPage_HideTrayRateButtonHeader"
                        Header="隐藏托盘评价按钮"
                        Description="在托盘右键菜单中隐藏评价应用选项"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnHideTrayRateButtonCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE90A;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="HideTrayRateButtonToggle"
                            Toggled="OnHideTrayRateButtonToggled"/>
                    </controls:SettingsCard>

                </StackPanel>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
