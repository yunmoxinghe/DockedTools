<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
        底部操作栏主题资源 - 使用 WinUI Gallery 标准
        背景使用 ApplicationPageBackgroundThemeBrush（页面背景色）
        这是 WinUI Gallery 在所有页面中使用的标准背景
        
        参考：WinUI 3 Gallery - MainWindow.xaml 和各个 Page 实现
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="BottomBarBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="BottomBarBackgroundBrush" ResourceKey="ApplicationPageBackgroundThemeBrush" />
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BottomBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
