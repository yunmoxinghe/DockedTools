<Project Sdk="Microsoft.NET.Sdk">

  <!--
    端到端测试的服务端宿主：真 BridgeService（Kestrel + WebSocket + 真 Store 落盘）。

    和另外三个测试工程的区别：
      测试/桥接后端/ → 测桥接逻辑，Store 用内存替身，客户端是 C# 自己写的
      测试/存储并发/ → 只测 Store 的并发与落盘
      测试/性能基准/ → 真桥接 + 真 Store，但只测快慢
      本工程          → 真桥接 + 真 Store，客户端换成**扩展真正要发布的那份 bridge.js**
                        （由 e2e.mjs 在 Node 里加载 浏览器插件/dist/lib/bridge.js）

    为什么要跨语言：前三个工程的客户端都是 C# 写的"我以为扩展会怎么发"。
    只有让扩展的正式产物自己跑一遍，才能证明「扩展和 app 的协议真的对得上」，
    而不是「我和我自己对得上」。Node 22 自带 WHATWG WebSocket，够当浏览器替身。

    跑法见同目录 README.md（一般用 e2e.mjs 一条命令拉起，不用手动跑这个）。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DockedTools.E2E</RootNamespace>
    <AssemblyName>BridgeE2EServer</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Shims.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="..\..\DockedTools\功能\浏览器扩展\*.cs" />
    <Compile Include="..\..\DockedTools\功能\页面\网页应用\共享\网页应用快捷方式存储.cs" />
    <Compile Include="..\..\DockedTools\功能\页面\网页应用\共享\网页应用快捷方式.cs" />
    <Compile Include="..\..\DockedTools\功能\页面\网页应用\共享\键盘映射按钮配置.cs" />
  </ItemGroup>

</Project>
