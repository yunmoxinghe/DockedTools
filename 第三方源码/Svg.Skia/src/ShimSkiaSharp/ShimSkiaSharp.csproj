<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- 【DockedTools 集成适配】上游多目标 (netstandard2.0;net461;...) 收窄为 net10.0：
         宿主只用 net10.0；net461 会触发 SDK 隐式注入 Microsoft.NETFramework.ReferenceAssemblies，
         与中央包管理冲突 (NU1009)，且白白拖慢 restore。 -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <EnableDefaultCompileItems>False</EnableDefaultCompileItems>
    <EnableDefaultItems>False</EnableDefaultItems>
    <IsPackable>True</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Description>SkiaSharp picture recorder object model shim.</Description>
    <PackageId>ShimSkiaSharp</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>vector graphics;rendering;2d;graphics;geometry;shapes;skiasharp;skia;model</PackageTags>
  </PropertyGroup>

  <Import Project="..\..\build\SourceLink.props" />
  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\ReferenceAssemblies.props" />

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**" />
  </ItemGroup>

</Project>
